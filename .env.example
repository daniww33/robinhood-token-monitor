# Telegram alerts
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
TELEGRAM_CHAT_ID=123456789

# Optional Discord alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional tuning
POLL_INTERVAL_MS=300000
STATE_FILE=./state.json
RUN_ONCE=false
ALERT_ON_FIRST_RUN=false
MINT_ALERT_MODE=first_per_contract

# Official Robinhood endpoints, override only if needed.
RH_ASSETS_URL=https://api.robinhood.com/rhj/assets
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Log polling controls. Robinhood Chain is fast, so keep ranges modest.
CONFIRMATIONS=20
BLOCK_CHUNK_SIZE=2000
ADDRESS_CHUNK_SIZE=75
RPC_REQUEST_DELAY_MS=300
RPC_MAX_RETRIES=5
